{
  "name": "@emtt/vue-monaco-ide",
  "version": "0.2.0",
  "description": "一个基于 Monaco Editor 的零 UI 框架依赖 Vue 3 代码编辑器工作台，集成由 Pyright LSP 驱动的 Python 智能提示，支持 TS/JS/Python/YAML/Markdown/JSON、二进制文件/图片/PDF 预览、服务端钩子、文件树、多页签和跨文件导航。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "monaco",
    "monaco-editor",
    "pyright",
    "lsp",
    "python",
    "code-editor",
    "typescript",
    "yaml",
    "markdown-preview",
    "file-tree"
  ],
  "main": "./dist/vue-monaco-ide.js",
  "module": "./dist/vue-monaco-ide.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-monaco-ide.js"
    },
    "./style.css": "./dist/style.css"
    ,"./utils/file-kind": {
      "types": "./dist/types/utils/file-kind.d.ts",
      "import": "./dist/utils/file-kind.js"
    },
    "./utils/path": {
      "types": "./dist/types/utils/path.d.ts",
      "import": "./dist/utils/path.js"
    },
    "./utils/language": {
      "types": "./dist/types/utils/language.d.ts",
      "import": "./dist/utils/language.js"
    },
    "./utils/markdown": {
      "types": "./dist/types/utils/markdown.d.ts",
      "import": "./dist/utils/markdown.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "quality": "prettier --write src/ playground/ site/ && eslint . --fix && prettier --check src/ playground/ site/ && eslint .",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test:dev": "vitest run",
    "pack": "pnpm quality && pnpm type-check && pnpm test:dev && pnpm build && npm pack --pack-destination artifacts --ignore-scripts",
    "publish:npm": "pnpm publish --access public --registry=https://registry.npmjs.org/",
    "build:site": "vite build --config site/vite.config.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "monaco-editor": "~0.52.2",
    "monaco-pyright-lsp": ">=0.1.7 <0.2",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "monaco-yaml": "^5.5.1",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26",
    "monaco-editor": "^0.52.2",
    "monaco-pyright-lsp": "^0.1.7",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "typescript": "~5.8.3",
    "vite": "^6.2.4",
    "vitest": "^3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "hao503106@163.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.7.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emtiantian/vue-monaco-editor.git"
  },
  "homepage": "https://emtiantian.github.io/vue-monaco-editor/",
  "bugs": {
    "url": "https://github.com/emtiantian/vue-monaco-editor/issues"
  }
}
