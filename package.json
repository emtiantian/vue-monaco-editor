{
  "name": "vue-monaco-ide",
  "version": "0.1.0",
  "description": "A zero-UI-framework Vue 3 code editor workbench built on Monaco Editor, with full Python IntelliSense powered by Pyright LSP. Supports TS/JS/Python/Markdown/JSON with a file tree, tabs and cross-file navigation.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "monaco",
    "monaco-editor",
    "pyright",
    "lsp",
    "python",
    "code-editor",
    "typescript",
    "file-tree"
  ],
  "main": "./dist/vue-monaco-ide.js",
  "module": "./dist/vue-monaco-ide.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-monaco-ide.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ playground/",
    "pack-check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.50.0 <0.53",
    "monaco-pyright-lsp": ">=0.1.7 <0.2",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.4.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "monaco-editor": "^0.52.2",
    "monaco-pyright-lsp": "^0.1.7",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "typescript": "~5.8.3",
    "vite": "^6.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TODO-OWNER/vue-monaco-ide.git"
  },
  "bugs": {
    "url": "https://github.com/TODO-OWNER/vue-monaco-ide/issues"
  },
  "homepage": "https://github.com/TODO-OWNER/vue-monaco-ide#readme"
}
